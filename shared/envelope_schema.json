{
  "$defs": {
    "CitationSource": {
      "additionalProperties": false,
      "description": "Inline citation attached to every fired rule and envelope.",
      "properties": {
        "guideline": {
          "description": "e.g. 'KDIGO 2024' or 'ADA Standards of Care 2026'",
          "title": "Guideline",
          "type": "string"
        },
        "section": {
          "description": "Section reference within the guideline, e.g. 'Chapter 3.2'",
          "title": "Section",
          "type": "string"
        },
        "rule_id": {
          "description": "Stable ID assigned to the rule in the rule spec",
          "title": "Rule Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Public URL or local file path",
          "title": "Url"
        },
        "verbatim_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional direct quote (kept short, with ellipsis as needed)",
          "title": "Verbatim Quote"
        }
      },
      "required": [
        "guideline",
        "section",
        "rule_id"
      ],
      "title": "CitationSource",
      "type": "object"
    },
    "ConstraintKind": {
      "description": "Per-nutrient target/ceiling/floor.",
      "enum": [
        "target",
        "min",
        "max"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ConstraintProvenance": {
      "additionalProperties": false,
      "properties": {
        "nutrient": {
          "$ref": "#/$defs/NutrientKind"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "envelope_id": {
          "title": "Envelope Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/CitationSource"
        }
      },
      "required": [
        "nutrient",
        "kind",
        "value",
        "unit",
        "envelope_id",
        "version",
        "author",
        "citation"
      ],
      "title": "ConstraintProvenance",
      "type": "object"
    },
    "EnvelopeStatus": {
      "description": "Lifecycle states of a nutrient envelope.\n\nHard architectural invariant: only APPROVED envelopes may be consumed by the\noptimiser or personal target guidance. PROPOSED, EDITED, and REJECTED\nenvelopes do not authorize live downstream use.",
      "enum": [
        "PROPOSED",
        "APPROVED",
        "REJECTED",
        "EDITED"
      ],
      "title": "EnvelopeStatus",
      "type": "string"
    },
    "ExclusionFlag": {
      "additionalProperties": false,
      "description": "Hard exclusions produced by rules (ingredients, dish categories, patterns).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExclusionKind"
        },
        "value": {
          "description": "Matchable value: ingredient name, category, or pattern string",
          "title": "Value",
          "type": "string"
        },
        "reason": {
          "description": "Human-readable explanation",
          "title": "Reason",
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/CitationSource"
        }
      },
      "required": [
        "kind",
        "value",
        "reason",
        "citation"
      ],
      "title": "ExclusionFlag",
      "type": "object"
    },
    "ExclusionKind": {
      "enum": [
        "ingredient",
        "dish_category",
        "macro_pattern",
        "diet_pattern"
      ],
      "title": "ExclusionKind",
      "type": "string"
    },
    "NutrientConstraint": {
      "additionalProperties": false,
      "description": "Per-nutrient target/ceiling/floor for a 24-hour plan.",
      "properties": {
        "nutrient": {
          "$ref": "#/$defs/NutrientKind"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "Canonical unit, e.g. 'mg', 'g', 'kcal'",
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstraintProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "nutrient",
        "kind",
        "value",
        "unit"
      ],
      "title": "NutrientConstraint",
      "type": "object"
    },
    "NutrientKind": {
      "enum": [
        "energy_kcal",
        "protein_g",
        "sodium_mg",
        "potassium_mg",
        "phosphorus_mg",
        "carbs_g",
        "fat_g",
        "sat_fat_g",
        "fiber_g",
        "sugar_g"
      ],
      "title": "NutrientKind",
      "type": "string"
    },
    "PatientSummary": {
      "additionalProperties": false,
      "description": "Minimal patient descriptors needed to explain an envelope.\n\nFull patient profile lives elsewhere; this is the audit-friendly subset\nfrozen with each envelope so traces remain readable months later.",
      "properties": {
        "patient_id": {
          "title": "Patient Id",
          "type": "string"
        },
        "age": {
          "maximum": 130,
          "minimum": 0,
          "title": "Age",
          "type": "integer"
        },
        "sex": {
          "enum": [
            "F",
            "M",
            "X"
          ],
          "title": "Sex",
          "type": "string"
        },
        "weight_kg": {
          "exclusiveMinimum": 0,
          "title": "Weight Kg",
          "type": "number"
        },
        "diagnoses": {
          "description": "e.g. ['T2D', 'HTN', 'CKD_stage_3']",
          "items": {
            "type": "string"
          },
          "title": "Diagnoses",
          "type": "array"
        },
        "egfr": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egfr"
        },
        "serum_K_meq_L": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Serum K Meq L"
        },
        "serum_PO4_mg_dL": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Serum Po4 Mg Dl"
        },
        "meds": {
          "items": {
            "type": "string"
          },
          "title": "Meds",
          "type": "array"
        }
      },
      "required": [
        "patient_id",
        "age",
        "sex",
        "weight_kg"
      ],
      "title": "PatientSummary",
      "type": "object"
    },
    "RuleFire": {
      "additionalProperties": false,
      "description": "A single rule firing \u2014 one row of the explainability trace.",
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "fired_at": {
          "format": "date-time",
          "title": "Fired At",
          "type": "string"
        },
        "patient_summary": {
          "description": "Conditions matched, e.g. 'CKD stage 4 + K+ = 5.4'",
          "title": "Patient Summary",
          "type": "string"
        },
        "action_summary": {
          "description": "What was set or asserted, e.g. 'Na ceiling = 2000 mg/d'",
          "title": "Action Summary",
          "type": "string"
        },
        "priority": {
          "description": "Higher wins on conflicts",
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "citation": {
          "$ref": "#/$defs/CitationSource"
        }
      },
      "required": [
        "rule_id",
        "fired_at",
        "patient_summary",
        "action_summary",
        "priority",
        "citation"
      ],
      "title": "RuleFire",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The full nutrient envelope contract.\n\nLive planning requires approval and scope eligibility. Lifecycle services\nenforce transitions; HTTP dependencies enforce downstream access.",
  "properties": {
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EnvelopeStatus",
      "default": "PROPOSED"
    },
    "version": {
      "default": 1,
      "description": "Content version; incremented by clinician edits",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "lifecycle_revision": {
      "default": 0,
      "description": "Concurrency token; incremented on every durable lifecycle update",
      "minimum": 0,
      "title": "Lifecycle Revision",
      "type": "integer"
    },
    "scope_eligible": {
      "default": true,
      "description": "Proposal eligibility, independent of editable notes and lifecycle status",
      "title": "Scope Eligible",
      "type": "boolean"
    },
    "patient_snapshot": {
      "$ref": "#/$defs/PatientSummary"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/NutrientConstraint"
      },
      "title": "Targets",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/ExclusionFlag"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "fired_rules": {
      "items": {
        "$ref": "#/$defs/RuleFire"
      },
      "title": "Fired Rules",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/CitationSource"
      },
      "title": "Citations",
      "type": "array"
    },
    "priority_basis": {
      "description": "Human-readable conflict priority used, e.g. 'CKD > HTN > T2D on sodium'",
      "title": "Priority Basis",
      "type": "string"
    },
    "proposed_by": {
      "default": "rules-engine",
      "title": "Proposed By",
      "type": "string"
    },
    "proposed_at": {
      "format": "date-time",
      "title": "Proposed At",
      "type": "string"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "envelope_id",
    "patient_id",
    "patient_snapshot",
    "targets",
    "priority_basis"
  ],
  "title": "NutrientEnvelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careloop.local/schemas/envelope.schema.json"
}
